{{! Sheet Header }}
<header class='sheet-header'>
  <div class='actor-header-first grid grid-4col'>
    <div class='actor-name grid-span-3'>
      <input
        type='text'
        name='name'
        class='actor-name-input'
        value='{{actor.name}}'
        data-dtype='String'
        placeholder='Name'
        {{#unless editable}}disabled{{/unless}}
      />
    </div>
    <div class='actor-level grid-span-1 align-right'>
      <label for='system-level'>Lvl:</label>
      <input
        type='text'
        name='system.level.value'
        class='actor-level-input'
        id='system-level'
        value='{{system.level.value}}'
        data-dtype='Number'
        placeholder='Level'
        {{#unless editable}}disabled{{/unless}}
      />
    </div>
  </div>
  <div class='tags-container' aria-label="Tags">
    {{#if system.tags}}
      {{#if system.tags.length}}
        <ul class="tag-list" role="list">
          {{#each system.tags as |tag|}}
            {{#if tag}}
              <li class="tag-chip {{#if (isAncestryTag tag)}}is-ancestry{{/if}} {{#if (isSizeTag tag)}}is-size{{/if}}" role="listitem" data-tag="{{tag}}">{{tagLabel tag}}</li>
            {{/if}}
          {{/each}}
        </ul>
      {{else}}
        <div class="tags-empty">No tags</div>
      {{/if}}
    {{else}}
      <div class="tags-empty">No tags</div>
    {{/if}}
  </div>
  

</header>